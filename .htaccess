# Canonical host redirect
# Keep the public site on https://www.firmendo.de/.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^firmendo\.de$ [NC]
RewriteRule ^ https://www.firmendo.de%{REQUEST_URI} [R=301,L]

# Explicit browser caching; mutable images and unversioned code expire quickly.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Moved pages
Redirect 301 /bestes-privatkonto-selbststaendige https://www.firmendo.de/privatkonto-als-geschaeftskonto

# BEGIN firmendo-affiliate (generiert von tools/generate-affiliate-redirects.rb – nicht von Hand bearbeiten)
# Quelle: tools/affiliate-links.txt
# Klick-Tracking aktiv: /go/<slug>/ -> t/go.php (zaehlt, haengt SubID an, 302 zum Partner).
RewriteEngine On
RewriteRule ^go/([a-z0-9]+(?:-[a-z0-9]+)*)/?$ t/go.php?slug=$1 [QSA,L]
# END firmendo-affiliate
